# Production Environment Template
DJANGO_SECRET_KEY=generate_with_python_secrets_token_urlsafe
JWT_SECRET=generate_with_python_secrets_token_urlsafe

DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Database & Storage
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=estatehub

# Email SMTP Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=EstateHub <noreply@estatehub.ai>

# ML Models
ML_MODELS_DIR=ml_scripts/models
